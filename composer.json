{
    "name": "webeak/file-bundle",
    "type": "symfony-bundle",
    "description": "Advanced file management bundle.",
    "keywords": [],
    "homepage": "https://webeak.fr",
    "license": "proprietary",
    "authors": [
        {
            "name": "Julien Pinto",
            "email": "jpinto@webeak.fr"
        }
    ],
    "require": {
        "php": "^7.1.3",
        "ext-curl": "*",
        "ext-json": "*",
        "doctrine/doctrine-bundle": "^1.10",
        "gregwar/image-bundle": "^2.2",
        "symfony/framework-bundle": "^4.2",
        "symfony/routing": "^4.1",
        "symfony/validator": "4.2.*",
        "webeak/essential-bundle": "^1.0",
        "webeak/utils": "^1.0"
    },
    "suggest": {
        "symfony/translation": "^4.2"
    },
    "autoload": {
        "psr-4": { "Webeak\\Bundle\\FileBundle\\": "src/" },
        "exclude-from-classmap": [
            "/Tests/"
